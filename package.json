{
  "name": "grm-soluciones-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "studio"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:studio\"",
    "lint": "npm run lint --workspaces",
    "build": "npm run build --workspaces"
  },
  "version": "1.0.0",
  "license": "GPL-3.0",
  "description": "Corporate website for GRM Soluciones, a technology solutions provider specializing in digital services for businesses and condominiums.",
  "author": "",
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
